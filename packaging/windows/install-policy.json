{
  "id": "open3d-launcher",
  "name": "Open3D Launcher",
  "mode": "perUser",
  "upgradeCode": "CDB388BE-1B69-49B3-8022-E38D8E027CAA",
  "sources": [
    "open3d-launcher.wxs"
  ],
  "icon": "assets/open3d/icon.ico",
  "localization": [
    "open3d-launcher.en-us.wxl"
  ],
  "extensions": [
    "UI",
    "Util"
  ],
  "payloads": [
    "LICENSE",
    "NOTICE",
    "open3d-launcher.exe"
  ],
  "customActions": [
    ["Open3DRestoreLauncherFolder", "51", "INSTALLFOLDER", "[PREVIOUSINSTALLFOLDER]"],
    ["SetINSTALLDESKTOPSHORTCUT", "307", "INSTALLDESKTOPSHORTCUT", "1"],
    ["RememberNoDesktopShortcut", "51", "DESKTOPSHORTCUTCHOICE", "0"],
    ["RememberDesktopShortcut", "51", "DESKTOPSHORTCUTCHOICE", "1"],
    ["LaunchOpen3DLauncher", "65", "Wix4UtilCA_{ARCH}", "WixShellExec"],
    ["WixUIPrintEula_{ARCH}", "65", "WixUiCa_{ARCH}", "PrintEula"],
    ["WixUIValidatePath_{ARCH}", "65", "WixUiCa_{ARCH}", "ValidatePath"],
    ["Open3DUninstallCleanup", "1106", "Open3DLauncherExe", "--uninstall-cleanup"]
  ],
  "uninstallCleanup": {
    "action": "Open3DUninstallCleanup",
    "condition": "REMOVE=\"ALL\" AND NOT UPGRADINGPRODUCTCODE",
    "after": "InstallInitialize",
    "before": "RemoveFiles"
  },
  "registry": [
    [
      "1",
      "Software\\Open3D\\Open3D Launcher",
      "InstallDir",
      "[INSTALLFOLDER]"
    ],
    [
      "1",
      "Software\\Open3D\\Open3D Launcher",
      "DesktopShortcutChoice",
      "[DESKTOPSHORTCUTCHOICE]"
    ],
    [
      "1",
      "Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\open3d-launcher.exe",
      "",
      "[#Open3DLauncherExe]"
    ],
    [
      "1",
      "Software\\Open3D\\Open3D Launcher",
      "StartMenuShortcut",
      "#1"
    ],
    [
      "1",
      "Software\\Open3D\\Open3D Launcher",
      "DesktopShortcut",
      "#1"
    ]
  ]
}
